<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><script>try{if(sessionStorage.getItem("zuajaSplash")){document.documentElement.classList.add("zuaja-no-splash")}else{sessionStorage.setItem("zuajaSplash","1")}}catch(e){document.documentElement.classList.add("zuaja-no-splash")}</script><link rel="icon" type="image/png" sizes="48x48" href="{{ 'zuaja-favicon-48.png' | asset_url }}"><link rel="apple-touch-icon" href="{{ 'zuaja-favicon-48.png' | asset_url }}"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'zuaja-2026-page.css' | asset_url | stylesheet_tag }}<script src="{{ 'zuaja-2026.js' | asset_url }}" defer></script>{% render 'zuaja-2026-typography' %}{% render 'zuaja-2026-brand-polish' %}<style>.zuaja-wa-float{position:fixed;inset-inline-end:16px;inset-block-end:16px;z-index:60;display:flex;align-items:center;gap:8px;padding:12px 16px;border-radius:999px;background:#25d366;color:#fff;font-weight:600;font-size:14px;text-decoration:none;box-shadow:0 6px 20px rgb(0 0 0 / .22)}.zuaja-wa-float svg{width:22px;height:22px;fill:currentColor;flex:none}.zuaja-wa-float:focus-visible{outline:2px solid #171717;outline-offset:3px}@media (max-width:600px){.zuaja-wa-float{padding:12px}.zuaja-wa-float span{display:none}}</style></head><body class="zuaja-2026" style="--ink: {{ settings.zuaja_ink }};--ink-deep: {{ settings.zuaja_ink_deep }};--sky: {{ settings.zuaja_sky }};--sky-pale: {{ settings.zuaja_sky_pale }};--purple: {{ settings.zuaja_purple }};--purple-deep: {{ settings.zuaja_purple_deep }};--pink: {{ settings.zuaja_pink }};--blue: {{ settings.zuaja_blue }};--yellow: {{ settings.zuaja_yellow }};">{% render 'zuaja-2026-splash' %}<a class="skip-link" href="#MainContent">{{ 'zuaja.general.skip' | t }}</a>{% sections 'zuaja-2026-header-group' %}<main id="MainContent" class="{% if template.name != 'index' %}inner-main{% endif %} {% if template.suffix contains 'quiz' %}quiz-page{% endif %}">{{ content_for_layout }}</main>{% sections 'zuaja-2026-footer-group' %}{% unless template.name == 'cart' %}<a class="zuaja-wa-float" href="https://wa.me/923161121130?text={{ 'Assalam o Alaikum Zuaja, I want to place an order' | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Order on WhatsApp">{% render 'zuaja-2026-social-icon', brand: 'whatsapp' %}<span>Order on WhatsApp</span></a>{% endunless %}</body></html>
