{% doc %}
Clean e-commerce product card (white image, price with saving, full-width add to cart).
@param {product} product - Product to show
@param {string} form_key - Unique key for the add-to-cart form id
{% enddoc %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign saving = 0
  if product.compare_at_price > product.price
    assign saving = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
-%}
<article class="zs-card">
  <a class="zs-card__media product-card__visual" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if saving > 0 -%}<span class="zs-card__badge">-{{ saving }}%</span>{%- endif -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: widths: '300, 450, 600, 800', sizes: '(max-width: 700px) 50vw, (max-width: 1000px) 33vw, 300px', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>
  <div class="zs-card__body">
    {%- if product.type != blank -%}<span class="zs-card__type">{{ product.type | escape }}</span>{%- endif -%}
    <h3 class="zs-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <p class="zs-card__price">
      <span>{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
    </p>
    {%- if product.available and product.has_only_default_variant -%}
      {%- assign fid = 'ZsCard-' | append: form_key | append: '-' | append: product.id -%}
      {%- form 'product', product, id: fid -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        <button class="zs-btn" type="submit">Add to Cart</button>
      {%- endform -%}
    {%- elsif product.available -%}
      <a class="zs-btn" href="{{ product.url }}">Choose option</a>
    {%- else -%}
      <button class="zs-btn" type="button" disabled>Sold out</button>
    {%- endif -%}
  </div>
</article>
