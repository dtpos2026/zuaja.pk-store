{% comment %}
  Section contract.
  Four short trust points under the hero.
{% endcomment %}
{{ 'zs.css' | asset_url | stylesheet_tag }}
<section class="zs zs-trust" aria-label="Why Zuaja PK">
  <ul class="zs-wrap">
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="m9 12 2 2 4-4"/></svg>{{ section.settings.t1 | escape }}</li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>{{ section.settings.t2 | escape }}</li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>{{ section.settings.t3 | escape }}</li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"/><path d="M9 10c.5 2 2 3.5 4 4"/></svg>{{ section.settings.t4 | escape }}</li>
  </ul>
</section>
